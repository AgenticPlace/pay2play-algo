# Algorand testnet config
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
ALGOD_PORT=443
ALGORAND_NETWORK=testnet-v1.0

# Wallet (generate via algosdk; NEVER commit real values)
ALGO_MNEMONIC="word1 word2 ... word25"

# After running `pnpm deploy`, copy the printed app id here
ALGO_APP_ID=0

# Server port (default 3010)
PORT=3010
